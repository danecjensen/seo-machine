{
  "name": "seo-machine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "wireframe": "node scripts/wireframe.mjs",
    "build:strict": "node scripts/build.mjs --strict",
    "serve": "node scripts/build.mjs --serve",
    "new-site": "node scripts/new-site.mjs",
    "design": "node scripts/design.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:assets": "node --test \"workers/assets.gohappyclub.com/test/*.test.mjs\"",
    "assets:dev": "wrangler dev --config workers/assets.gohappyclub.com/wrangler.toml"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.6",
    "markdown-it-anchor": "9.2.1",
    "node-html-parser": "9.0.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "playwright-core": "1.56.1",
    "wrangler": "4.142.0"
  }
}
