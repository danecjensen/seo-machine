---
// Visible FAQ: Google only honors FAQPage markup when the answers are on the page.
const { items, heading = "Frequently asked questions" } = Astro.props;
---
{items?.length > 0 && (
  <section class="faq" aria-labelledby="faq-heading">
    <h2 id="faq-heading">{heading}</h2>
    {items.map(({ q, a }) => (
      <details>
        <summary>{q}</summary>
        <p>{a}</p>
      </details>
    ))}
  </section>
)}
