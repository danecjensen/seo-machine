---
import site from "virtual:seo-machine/site";
import Base from "../layouts/Base.astro";
import { head } from "../lib/seo.mjs";

const page = { url: "/404/", kind: "page", data: { title: "Page not found", description: "This page does not exist.", noindex: true } };
---
<Base seo={head(site, page, new Map())} url="/404/">
  <header class="page-head">
    <h1>Page not found</h1>
    <p class="lede">The page you were looking for has moved or never existed.</p>
  </header>
  <p><a class="btn" href="/">Go to the home page</a></p>
</Base>
